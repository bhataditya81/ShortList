# Auth.js (required in production)
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Legacy demo cookie signing — unused when Auth.js is active; keep for local tools if needed
SESSION_SECRET=dev-only-change-me

# Admin: Featured slots + ledger import UI
FEATURED_ADMIN_SECRET=dev-featured

# Postgres (Neon serverless). Omit for local JSON file store under data/shortlist-store.json
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Optional after you join programs via the forms in docs/affiliate-applications.md
# RAILWAY_AFFILIATE_URL=
# DIGITALOCEAN_AFFILIATE_URL=
# PINECONE_AFFILIATE_URL=
# Stripe Featured (self-serve, no sales team)
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_FEATURED=
# STRIPE_WEBHOOK_SECRET=
