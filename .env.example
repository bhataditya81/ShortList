# Auth.js — required. Generate: openssl rand -base64 32
AUTH_SECRET=

# Legacy demo cookie signing — unused when Auth.js is active
SESSION_SECRET=

# Admin: Featured slots + ledger import UI. Must NOT be "dev-featured".
# Generate: openssl rand -base64 24
FEATURED_ADMIN_SECRET=

# Private beta allowlist (comma-separated). Unset = any email can sign in (local only).
# SHORTLIST_ALLOWED_EMAILS=you@example.com

# Postgres (Neon serverless). Required on Vercel. Omit locally to use data/shortlist-store.json
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# P0 #1 — Railway referral (https only). Paste the exact URL Railway gives you.
# RAILWAY_AFFILIATE_URL=https://railway.com/?referralCode=YOUR_CODE

# Optional later
# DIGITALOCEAN_AFFILIATE_URL=
# PINECONE_AFFILIATE_URL=
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_FEATURED=
# STRIPE_WEBHOOK_SECRET=
